generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repo {
  id        String    @id @default(uuid())
  fullName  String    @unique
  createdAt DateTime  @default(now())
  failures  Failure[]
}

model Failure {
  id             String   @id @default(uuid())
  repoId         String
  runId          String
  status         String
  failingCommand String?
  rootCause      String?
  suggestedFix   String?
  createdAt      DateTime @default(now())
  repo           Repo     @relation(fields: [repoId], references: [id])
}

model WorkflowAnalysis {
  id         Int      @id @default(autoincrement())
  runId      BigInt   @unique
  owner      String
  repository String
  status     String
  conclusion String
  analysis   String
  createdAt  DateTime @default(now())
}
